/* ============================================================
   style_dark.qss  —  Dark Theme
   Applied via the "Dark Mode" toggle button in AdminDashboard
   ============================================================

   COLOR PALETTE (Dark Mode):
     Background   : #1e2736  (deep navy)
     Surface      : #2c3e50  (card/panel)
     Primary      : #e74c3c  (bright red)
     Text         : #ecf0f1  (off-white)
     Border       : #3d4f61
     Accent       : #27ae60
   ============================================================ */

/* ---- Base Widget ---- */
QWidget {
    background-color: #1e2736;
    color: #ecf0f1;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #1e2736;
}

QLabel {
    color: #ecf0f1;
    background: transparent;
}

/* ---- Line Edit ---- */
QLineEdit {
    background-color: #2c3e50;
    color: #ecf0f1;
    border: 1px solid #3d4f61;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    selection-background-color: #c0392b;
}
QLineEdit:focus {
    border: 2px solid #e74c3c;
    background-color: #34495e;
}
QLineEdit:disabled {
    background-color: #253545;
    color: #7f8c8d;
}

/* ---- Push Button ---- */
QPushButton {
    background-color: #c0392b;
    color: #ffffff;
    border: none;
    border-radius: 7px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton:hover  { background-color: #e74c3c; }
QPushButton:pressed { background-color: #a93226; }
QPushButton:disabled {
    background-color: #3d4f61;
    color: #7f8c8d;
}

/* ---- ComboBox ---- */
QComboBox {
    background-color: #2c3e50;
    color: #ecf0f1;
    border: 1px solid #3d4f61;
    border-radius: 6px;
    padding: 6px 10px;
}
QComboBox:focus { border: 2px solid #e74c3c; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #2c3e50;
    color: #ecf0f1;
    selection-background-color: #c0392b;
    border: 1px solid #3d4f61;
}

/* ---- SpinBox ---- */
QSpinBox {
    background-color: #2c3e50;
    color: #ecf0f1;
    border: 1px solid #3d4f61;
    border-radius: 6px;
    padding: 6px;
}
QSpinBox:focus { border: 2px solid #e74c3c; }

/* ---- Table Widget ---- */
QTableWidget {
    background-color: #253545;
    gridline-color: #2c3e50;
    border: 1px solid #3d4f61;
    alternate-background-color: #2a3f52;
    selection-background-color: #c0392b;
    selection-color: #ffffff;
    color: #ecf0f1;
}
QTableWidget::item { padding: 5px 8px; }
QHeaderView::section {
    background-color: #1a252f;
    color: #ecf0f1;
    font-weight: bold;
    padding: 8px;
    border: none;
    border-right: 1px solid #3d4f61;
}

/* ---- Progress Bar ---- */
QProgressBar {
    background-color: #2c3e50;
    border: 1px solid #3d4f61;
    border-radius: 5px;
    height: 14px;
    color: #ecf0f1;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #27ae60;
    border-radius: 5px;
}

/* ---- Scroll Bar ---- */
QScrollBar:vertical {
    background: #253545;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #3d4f61;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #e74c3c; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }

/* ---- Message Box ---- */
QMessageBox { background-color: #2c3e50; color: #ecf0f1; }
QMessageBox QPushButton { min-width: 80px; }

/* ---- Sidebar (AdminDashboard) ---- */
#sidebar {
    background-color: #1a252f;
    border-right: 2px solid #0d1117;
}
#sidebar QLabel {
    color: #7f8c8d;
    font-size: 11px;
    font-weight: bold;
    padding: 8px 4px 4px 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
}
#sidebar QPushButton {
    background-color: #253545;
    color: #bdc3c7;
    border-radius: 5px;
    text-align: left;
    padding: 10px 12px;
    font-size: 13px;
    font-weight: normal;
    border: none;
}
#sidebar QPushButton:hover {
    background-color: #e74c3c;
    color: #ffffff;
    font-weight: bold;
}

/* ---- Top bar ---- */
#lblWelcome {
    font-size: 14px;
    font-weight: bold;
    color: #ecf0f1;
    padding: 6px;
}
#lblAlert {
    color: #e74c3c;
    font-weight: bold;
    font-size: 12px;
    padding: 6px;
}

/* ---- Stacked Widget ---- */
QStackedWidget {
    background-color: #1e2736;
    border-left: 1px solid #2c3e50;
}
